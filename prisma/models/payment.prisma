model Payment {
  id             String        @id @default(uuid())
  status         PaymentStatus @default(PENDING)
  stripeIntentId String        @unique
  amount         Float
  paidAt         DateTime?
  updatedAt      DateTime      @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@map("payment")
}
