model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  status     UserStatus @default(ACTIVE)
  role       Role       @default(CUSTOMER)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt()

  technicians Technician?
  myBookings  Booking[]

  @@map("user")
}
